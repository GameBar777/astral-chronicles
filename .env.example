# --- Database (local dev; never commit real .env) ---
DATABASE_URL=postgres://astral:CHANGE_ME@127.0.0.1:5433/astral
PG_PORT=5433
PG_BIN=/opt/astral-pg/bin
# --- Server ---
SERVER_PORT=2567
NODE_ENV=development
# Auth (self-hosted interim, see TECHNICAL_DECISIONS.md). Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
BCRYPT_ROUNDS=12
# --- Client (only VITE_* vars are exposed to the browser; no secrets here) ---
VITE_SERVER_URL=ws://localhost:2567
