# ASTRAL CHRONICLES — environment template. Copy to .env and fill in. Never commit a real .env.
# --- Database ---
DATABASE_URL=postgres://astral:CHANGE_ME@127.0.0.1:5433/astral
PG_PORT=5433
# local PostgreSQL binaries (scripts/bootstrap-env.sh installs them here on the dev box)
PG_BIN=/workspace/.tools/astral-pg/bin
# --- Server ---
SERVER_PORT=2567
# development | production   (production: refuses default DB password, enables HSTS, serves client/dist)
NODE_ENV=development
BCRYPT_ROUNDS=12
# comma-separated origins allowed to open the game WebSocket (empty = any; set it in production)
ALLOWED_ORIGINS=
# set when running behind a TLS-terminating reverse proxy (e.g. 1, or loopback) so rate limits / audit see the real IP
TRUST_PROXY=
# extra origin allowed in the CSP connect-src (e.g. wss://game.example.com) when the WS host differs from the page host
PUBLIC_WS_ORIGIN=
# absolute path of the built client (default: ../client/dist)
CLIENT_DIST=
# --- Client build (only VITE_* vars reach the browser; never put secrets here) ---
# optional explicit WebSocket URL; default = same origin in production builds, :2567 in dev
VITE_GAME_WS=
